# =====================================================================
# SevaSetu Environment Configuration Template
# =====================================================================
# IMPORTANT: In production, load secrets securely via Google Secret Manager.
# Never commit actual API keys or credentials to version control.

# Gemini API configuration (Required for AI extraction & explanation)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
GEMINI_MODEL=gemini-2.5-flash

# Feature Flags for Google Cloud Services
# Set to 'true' to enable Google Cloud Speech-to-Text server route
ENABLE_SPEECH_TO_TEXT=false

# Set to 'true' to enable Google Cloud Translation API
ENABLE_TRANSLATION=false

# Set to 'true' to enable Google Cloud Firestore persistence
ENABLE_FIRESTORE=false

# Google Cloud Project & Credentials (Required if feature flags are enabled)
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# Path to service account JSON (only when running outside Google Cloud Run)
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# Server port (default: 3000)
PORT=3000
